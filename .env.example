# ---------- Supabase (banco de dados e login do painel) ----------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="chave-anon-publishable"
SUPABASE_SERVICE_ROLE_KEY="chave-service-role"

# Quem entra no painel são as pessoas cadastradas em Authentication -> Users.
# A primeira você cria à mão; o resto entra por convite, em Painel -> Equipe.
# Para o convite chegar, configure o SMTP em Authentication -> Emails.

# ---------- Google Calendar (opcional: dá para preencher pelo painel) ----------
# O caminho normal é Painel -> Agenda -> Preencher credenciais, que guarda no
# banco. Estas variáveis continuam valendo como reserva e vencem sobre ele.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Deixe vazio para o painel montar sozinho, a partir de NEXT_PUBLIC_APP_URL.
GOOGLE_REDIRECT_URI=""
GOOGLE_CALENDAR_ID="primary"

# ---------- App ----------
# O nome, as cores e o logo do ateliê ficam em Painel -> Marca, não aqui.
# Ao publicar, troque para o endereço real: é o que vai impresso no cartaz do QR.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="outro-texto-aleatorio"

# ---------- E-mail dos lembretes (opcional) ----------
RESEND_API_KEY=""
EMAIL_DESTINO=""
EMAIL_REMETENTE="Ateliê <onboarding@resend.dev>"
